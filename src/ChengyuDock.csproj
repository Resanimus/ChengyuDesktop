<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ChengyuDock</AssemblyName>
    <RootNamespace>ChengyuDock</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.8.0</Version>
    <Product>澄屿桌面</Product>
    <Description>原生桌面组件、壁纸与 Dock</Description>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- WPF owns per-monitor DPI via app.manifest; WinForms is used only for the tray icon. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="BrandMark.png" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <Content Include="native\ChengyuGlass.dll" Link="ChengyuGlass.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
